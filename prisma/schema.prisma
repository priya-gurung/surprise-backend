generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Wishlist {
  id           String   @id @default(uuid())
  code         String   @unique
  title        String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items Item[]
  guests Guest[]

  @@map("wishlists")
}

model Guest {
  id           String   @id @default(uuid())
  wishlistId   String
  wishlist     Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  name         String   // normalized lowercase — used for uniqueness & login lookup
  displayName  String   // original case — used for "Welcome back, Alice"
  passwordHash String
  createdAt    DateTime @default(now())

  items Item[]

  @@unique([wishlistId, name])   // case-insensitive uniqueness within a wishlist
  @@index([wishlistId])
  @@map("guests")
}

model Item {
  id         String    @id @default(uuid())
  wishlistId String
  wishlist   Wishlist  @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  title      String
  productUrl String
  imageUrl   String?
  notes      String?
  priority   Priority  @default(MEDIUM)

  reserved   Boolean   @default(false)
  reservedById String? 
  reservedBy   Guest?    @relation(fields: [reservedById], references: [id], onDelete: SetNull)
  reservedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wishlistId])
  @@map("items")
}

// Simple persistent cache so we don't re-fetch & re-parse the same product
// page's Open Graph metadata on every request. A background job or TTL
// check can prune old rows; see backend/src/lib/linkPreview.js.
model LinkPreviewCache {
  id        String   @id @default(uuid())
  url       String   @unique
  imageUrl  String?
  fetchedAt DateTime @default(now())

  @@map("link_preview_cache")
}
